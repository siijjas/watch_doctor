 "html": "<style>\r\n   .print-format,\r\n   .print-format table,\r\n   .print-format tr,\r\n   .print-format td,\r\n   .print-format div,\r\n   .print-format p {\r\n     font-family: Arial, sans-serif;\r\n     line-height: 115%;\r\n     vertical-align: top;\r\n     margin: 0;\r\n     padding: 0;\r\n     box-sizing: border-box;\r\n   }\r\n   @media screen {\r\n     .print-format {\r\n       width: 1.5in;\r\n       padding: 0.07in 0.08in;\r\n       min-height: 1in;\r\n     }\r\n   }\r\n   @media print {\r\n     @page {\r\n       size: 1.5in 1in;\r\n       margin: 0;\r\n     }\r\n     .print-format {\r\n       width: 1.5in;\r\n       height: 1in;\r\n       padding: 0.07in 0.08in;\r\n       overflow: hidden;\r\n     }\r\n   }\r\n   .dw-lbl {\r\n     width: 100%;\r\n     display: flex;\r\n     flex-direction: column;\r\n     gap: 3px;\r\n     height: 100%;\r\n   }\r\n   .dw-lbl .ro-id {\r\n     font-size: 14pt;\r\n     font-weight: bold;\r\n     display: block;\r\n     text-align: center;\r\n     letter-spacing: 0.02em;\r\n     white-space: nowrap;\r\n     overflow: hidden;\r\n     text-overflow: ellipsis;\r\n   }\r\n   .dw-lbl .watch-count {\r\n     font-size: 9pt;\r\n     font-weight: bold;\r\n     text-align: center;\r\n     white-space: nowrap;\r\n   }\r\n   .dw-lbl .watch-list {\r\n     font-size: 8pt;\r\n     text-align: left;\r\n     overflow: hidden;\r\n     flex: 1;\r\n   }\r\n   .dw-lbl .watch-item {\r\n     white-space: nowrap;\r\n     overflow: hidden;\r\n     text-overflow: ellipsis;\r\n     line-height: 1.2;\r\n   }\r\n </style>\r\n \r\n {%- set _ref = doc.reference_number or doc.name -%}\r\n \r\n <div class='dw-lbl'>\r\n   <span class='ro-id'>{{ (_ref) | e }}</span>\r\n   {%- if doc.items %}\r\n   <span class='watch-count'>Qty: {{ (doc.items | length) | e }}</span>\r\n   <div class='watch-list'>\r\n     {%- for item in doc.items %}\r\n     <div class='watch-item'>{{ (loop.index) | e }}. {{ (item.watch_brand or \"N/A\") | e }} </div>\r\n     {%- endfor %}\r\n   </div>\r\n   {%- endif -%}\r\n </div>",
