 "doc_type": "DW Repair Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n  @page {\n    size: A4;\n    margin: 16mm 15mm;\n    @bottom-right {\n      content: \"Page \" counter(page) \" of \" counter(pages);\n      font-size: 7.5pt;\n      color: #bbb;\n    }\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n\n  body {\n    font-family: 'DM Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    font-size: 9pt;\n    color: #1a1a1a;\n    line-height: 1.55;\n    margin: 0;\n    padding: 0;\n    background: #fff;\n  }\n\n  /* \u2500\u2500\u2500 HEADER \u2500\u2500\u2500 */\n  .doc-header {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n    align-items: center;\n    column-gap: 24px;\n    border-bottom: 2px solid #1a1a1a;\n    padding-bottom: 12px;\n    margin-bottom: 12px;\n  }\n  .doc-logo { display: flex; justify-content: center; align-items: center; }\n  .doc-logo img { max-height: 64px; max-width: 220px; width: auto; display: block; }\n  .company-info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }\n  .company-name {\n    font-family: 'DM Serif Display', Georgia, serif;\n    font-size: 11pt;\n    color: #1a1a1a;\n    font-weight: 600;\n  }\n  .company-sub { font-size: 7.5pt; color: #888; }\n  .doc-title-block { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }\n  .doc-title {\n    font-family: 'DM Serif Display', Georgia, serif;\n    font-size: 17pt;\n    color: #1a1a1a;\n    letter-spacing: 0.4px;\n    display: block;\n  }\n  .doc-subtitle {\n    font-size: 7.5pt;\n    color: #aaa;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    margin-top: 3px;\n    display: block;\n  }\n\n  /* \u2500\u2500\u2500 META BAND \u2500\u2500\u2500 */\n  .doc-meta {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    align-items: start;\n    column-gap: 28px;\n    padding: 8px 0 9px;\n    border-bottom: 0.5px solid #d0d0d0;\n    margin-bottom: 14px;\n  }\n  .meta-label {\n    font-size: 7pt;\n    letter-spacing: 0.8px;\n    text-transform: uppercase;\n    color: #aaa;\n    margin-bottom: 2px;\n  }\n  .customer-name {\n    font-family: 'DM Serif Display', Georgia, serif;\n    font-size: 12.5pt;\n    color: #1a1a1a;\n    line-height: 1.2;\n  }\n  .customer-phone { font-size: 8pt; color: #666; margin-top: 1px; line-height: 1.25; }\n  .ref-table { border-collapse: collapse; font-size: 8pt; }\n  .ref-table td { padding: 1.5px 0; }\n  .ref-table td:first-child { color: #aaa; padding-right: 14px; white-space: nowrap; }\n  .ref-table td:last-child { color: #1a1a1a; font-weight: 500; text-align: right; }\n\n  /* \u2500\u2500\u2500 SECTION HEADING \u2500\u2500\u2500 */\n  .section-heading {\n    font-size: 7.5pt;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    color: #999;\n    font-weight: 500;\n    margin: 20px 0 10px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .section-heading::before {\n    content: '';\n    display: inline-block;\n    width: 20px;\n    height: 1.5px;\n    background: #1a1a1a;\n    flex-shrink: 0;\n  }\n\n  /* \u2500\u2500\u2500 WATCH CARD \u2500\u2500\u2500 */\n  .watch-card {\n    border: 0.5px solid #d4d4d4;\n    margin-bottom: 14px;\n    page-break-inside: avoid;\n  }\n  .watch-card-head {\n    background: #f8f8f8;\n    padding: 9px 14px;\n    border-bottom: 0.5px solid #d4d4d4;\n  }\n  .watch-card-title {\n    font-family: 'DM Serif Display', Georgia, serif;\n    font-size: 10.5pt;\n    color: #1a1a1a;\n  }\n  .watch-card-body { padding: 11px 14px; }\n\n  /* \u2500\u2500\u2500 DETAIL GRID \u2500\u2500\u2500 */\n  .detail-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 8px 18px;\n  }\n  .detail-lbl {\n    font-size: 7pt;\n    color: #bbb;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 1px;\n  }\n  .detail-val { font-size: 8.5pt; color: #1a1a1a; font-weight: 500; }\n  .detail-val.na { color: #ccc; font-weight: 400; font-style: italic; }\n\n  /* \u2500\u2500\u2500 PHOTO GRID \u2500\u2500\u2500 */\n  .photo-wrap {\n    margin-top: 10px;\n    padding-top: 9px;\n    border-top: 0.5px solid #ebebeb;\n  }\n  .photo-lbl {\n    font-size: 7pt;\n    color: #bbb;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 6px;\n  }\n  .photo-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 8px;\n  }\n  .photo-cell {\n    border: 0.5px solid #d4d4d4;\n    padding: 4px;\n    page-break-inside: avoid;\n  }\n  .photo-cell img {\n    width: 100%;\n    height: 130px;\n    object-fit: contain;\n    display: block;\n    background: #f4f4f4;\n  }\n  .photo-caption {\n    font-size: 6.8pt;\n    color: #888;\n    text-align: center;\n    margin-top: 3px;\n  }\n  .no-photos {\n    font-size: 7.8pt;\n    color: #bbb;\n    font-style: italic;\n    padding: 6px 0;\n  }\n\n  /* \u2500\u2500\u2500 DISCLAIMER \u2500\u2500\u2500 */\n  .ack-box {\n    margin-top: 14px;\n    padding: 10px 12px;\n    border: 0.5px solid #d0d0d0;\n    font-size: 7.4pt;\n    color: #555;\n    line-height: 1.5;\n    background: #fafafa;\n    page-break-inside: avoid;\n  }\n  .ack-title { font-weight: 600; color: #1a1a1a; margin-bottom: 4px; font-size: 8pt; }\n  .ack-box ol { margin: 0; padding-left: 14px; }\n  .ack-box li { margin-bottom: 4px; }\n  .ack-box li:last-child { margin-bottom: 0; }\n\n  /* \u2500\u2500\u2500 FOOTER \u2500\u2500\u2500 */\n  .doc-footer {\n    margin-top: 16px;\n    padding-top: 7px;\n    border-top: 0.5px solid #e8e8e8;\n    text-align: center;\n    font-size: 7pt;\n    color: #ccc;\n    letter-spacing: 0.5px;\n  }\n</style>\n\n{#-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n     DATA SETUP\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 --#}\n{%- set _logo_url = frappe.db.get_default(\"dw_logo_url\", \"watch_doctor\") or \"\" -%}\n{%- set _default_company = frappe.db.get_value(\"Global Defaults\", None, \"default_company\") or \"\" -%}\n{%- set _general_config_exists = frappe.db.exists(\"DocType\", \"DW General Configuration\") -%}\n{%- set _company_name = (frappe.db.get_single_value(\"DW General Configuration\", \"company_name\") if _general_config_exists else \"\") or (frappe.db.get_value(\"Company\", _default_company, \"company_name\") if _default_company else \"\") or _default_company or \"Watch Doctor\" -%}\n{%- set _company_phone = (frappe.db.get_single_value(\"DW General Configuration\", \"company_phone\") if _general_config_exists else \"\") or (frappe.db.get_value(\"Company\", _default_company, \"phone_no\") if _default_company else \"\") or \"\" -%}\n{%- set _company_address = (frappe.db.get_single_value(\"DW General Configuration\", \"company_address\") if _general_config_exists else \"\") or \"\" -%}\n{%- set _cust_info = frappe.db.get_value(\"Customer\", doc.customer, [\"customer_name\", \"mobile_no\", \"whatsapp_no\"], as_dict=1) or {} -%}\n{%- set _cn = _cust_info.get(\"customer_name\") or doc.customer -%}\n{%- set _mob = _cust_info.get(\"mobile_no\") or \"\" -%}\n{%- set _wa = _cust_info.get(\"whatsapp_no\") or \"\" -%}\n\n\n{#-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n     HEADER\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 --#}\n<div class=\"doc-header\">\n  <div class=\"company-info\">\n    <div class=\"company-name\">{{ _company_name }}</div>\n    {%- if _company_address %}<div class=\"company-sub\">{{ _company_address | replace(\"\\n\", \", \") }}</div>{%- endif %}\n    {%- if _company_phone %}<div class=\"company-sub\">Tel: {{ _company_phone }}</div>{%- endif %}\n  </div>\n\n  <div class=\"doc-logo\">\n    {%- if _logo_url -%}\n    <img src=\"{{ _logo_url }}\" alt=\"{{ _company_name }}\" onerror=\"this.style.display='none'\">\n    {%- endif -%}\n  </div>\n\n  <div class=\"doc-title-block\">\n    <span class=\"doc-title\">Product Visible Condition Report</span>\n    <span class=\"doc-subtitle\">Recorded at Intake</span>\n  </div>\n</div>\n\n\n{#-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n     META BAND\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 --#}\n<div class=\"doc-meta\">\n  <div>\n    <div class=\"meta-label\">Customer</div>\n    <div class=\"customer-name\">{{ _cn }}</div>\n    {%- if _mob %}<div class=\"customer-phone\">Mobile: {{ _mob }}</div>{%- endif %}\n    {%- if _wa %}<div class=\"customer-phone\">WhatsApp: {{ _wa }}</div>{%- endif %}\n  </div>\n\n  <div>\n    <table class=\"ref-table\">\n      <tr>\n        <td>Repair Order No.</td>\n        <td>{{ doc.name }}</td>\n      </tr>\n      <tr>\n        <td>Date</td>\n        <td>{{ frappe.utils.formatdate(doc.received_date) }}</td>\n      </tr>\n      <tr>\n        <td>Unique ID</td>\n        <td>{{ doc.public_token or \"\u2014\" }}</td>\n      </tr>\n    </table>\n  </div>\n</div>\n\n\n{#-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n     WATCH ITEMS  (one card per repair item: attributes + photos)\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 --#}\n<div class=\"section-heading\">Visible Condition of Product</div>\n\n{%- for item in doc.items -%}\n\n{%- set _brand = frappe.db.get_value(\"DW Watch Brand\", item.watch_brand, \"brand_name\") or item.watch_brand or \"\u2014\" -%}\n{%- set _model = frappe.db.get_value(\"DW Watch Model\", item.watch_model, \"model_name\") or item.watch_model or \"\u2014\" -%}\n{%- set _item_photos = doc.all_photos | selectattr(\"repair_item_key\", \"equalto\", item.idx | string) | list -%}\n\n<div class=\"watch-card\">\n  <div class=\"watch-card-head\">\n    <div class=\"watch-card-title\">\n      Watch {{ \"%02d\" | format(item.idx) }}\n      &nbsp;&mdash;&nbsp;\n      {{ _brand }}{% if item.watch_model %} &middot; {{ _model }}{% endif %}\n    </div>\n  </div>\n\n  <div class=\"watch-card-body\">\n\n    <div class=\"detail-grid\">\n      <div>\n        <div class=\"detail-lbl\">Brand</div>\n        <div class=\"detail-val\">{{ _brand }}</div>\n      </div>\n      <div>\n        <div class=\"detail-lbl\">Model</div>\n        <div class=\"detail-val\">{{ _model }}</div>\n      </div>\n      <div>\n        <div class=\"detail-lbl\">Serial No.</div>\n        <div class=\"detail-val {{ 'na' if not item.serial_number }}\">{{ item.serial_number or \"Not provided\" }}</div>\n      </div>\n      <div>\n        <div class=\"detail-lbl\">Case Type</div>\n        <div class=\"detail-val {{ 'na' if not item.case_type }}\">{{ item.case_type or \"Not provided\" }}</div>\n      </div>\n      <div>\n        <div class=\"detail-lbl\">Strap / Bracelet</div>\n        <div class=\"detail-val {{ 'na' if not item.strap_bracelet }}\">{{ item.strap_bracelet or \"Not provided\" }}</div>\n      </div>\n      <div>\n        <div class=\"detail-lbl\">Watch Type</div>\n        <div class=\"detail-val {{ 'na' if not item.watch_type }}\">{{ item.watch_type or \"Not provided\" }}</div>\n      </div>\n      <div>\n        <div class=\"detail-lbl\">Dial</div>\n        <div class=\"detail-val {{ 'na' if not item.dial }}\">{{ item.dial or \"Not provided\" }}</div>\n      </div>\n    </div>\n\n    <div class=\"photo-wrap\">\n      <div class=\"photo-lbl\">Visible Condition Photos</div>\n      {%- if _item_photos and _item_photos | length -%}\n      <div class=\"photo-grid\">\n        {%- for photo in _item_photos -%}\n        <div class=\"photo-cell\">\n          <img src=\"{{ photo.image }}\" alt=\"Visible condition photo\">\n          {%- if photo.caption %}<div class=\"photo-caption\">{{ photo.caption }}</div>{%- endif %}\n        </div>\n        {%- endfor -%}\n      </div>\n      {%- else -%}\n      <div class=\"no-photos\">No photos captured for this watch.</div>\n      {%- endif %}\n    </div>\n\n  </div>\n</div>\n\n{%- endfor %}\n\n\n{#-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n     DISCLAIMER\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 --#}\n<div class=\"ack-box\">\n  <div class=\"ack-title\">Disclaimer</div>\n  <ol>\n    <li>Visible condition captured is based on primary visual inspection carried out at the time of submitting the repair.</li>\n    <li>This document reports the visible condition of the product and does not replace the repair order form.</li>\n  </ol>\n</div>\n\n\n{#-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n     FOOTER\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 --#}\n<div class=\"doc-footer\">\n  {{ _company_name }}&nbsp;&middot;&nbsp;Product Visible Condition Report&nbsp;&middot;&nbsp;Order {{ doc.name }}\n</div>\n",
