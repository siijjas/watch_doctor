 "html": "<style>\n  .print-format,\n  .print-format table,\n  .print-format tr,\n  .print-format td,\n  .print-format div,\n  .print-format p {\n    font-family: Arial, sans-serif;\n    line-height: 115%;\n    vertical-align: middle;\n    white-space: nowrap;\n    overflow: hidden;\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n  @media screen {\n    .print-format {\n      width: 1.5in;\n      padding: 0.06in 0.07in;\n      min-height: 1in;\n    }\n  }\n  @media print {\n    @page {\n      size: 1.5in 1in;\n      margin: 0;\n    }\n    .print-format {\n      width: 1.5in;\n      height: 1in;\n      padding: 0.06in 0.07in;\n      overflow: hidden;\n    }\n  }\n  .dw-lbl {\n    display: flex;\n    align-items: center;\n    gap: 0.04in;\n    width: 100%;\n    height: 0.88in;\n  }\n  .dw-lbl .qr {\n    flex: 0 0 0.62in;\n    width: 0.62in;\n    height: 0.62in;\n    display: block;\n  }\n  .dw-lbl .qr svg {\n    width: 0.62in;\n    height: 0.62in;\n    display: block;\n  }\n  .dw-lbl .txt {\n    flex: 1 1 auto;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 2px;\n  }\n  .dw-lbl .ro-id {\n    font-size: 10pt;\n    font-weight: bold;\n    letter-spacing: -0.02em;\n    overflow: hidden;\n    text-overflow: clip;\n  }\n  .dw-lbl .order-no {\n    font-size: 6.5pt;\n    overflow: hidden;\n  }\n  .dw-lbl .cust-name {\n    font-size: 7pt;\n    font-weight: bold;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .dw-lbl .mobile {\n    font-size: 7pt;\n    overflow: hidden;\n  }\n</style>\n\n{%- set _cn = frappe.db.get_value(\"Customer\", doc.customer, \"customer_name\") or doc.customer -%}\n{%- set _mb = frappe.db.get_value(\"Customer\", doc.customer, \"mobile_no\") or \"\" -%}\n{%- set _ref = doc.reference_number or doc.name -%}\n{#- Local number only; the label is too narrow for the +973 prefix. -#}\n{%- set _digits = (_mb | replace(\"+\", \"\") | replace(\" \", \"\") | replace(\"-\", \"\")) -%}\n{%- if _digits.startswith(\"00\") %}{% set _digits = _digits[2:] %}{% endif -%}\n{%- if _digits.startswith(\"973\") and _digits | length > 8 %}{% set _digits = _digits[3:] %}{% endif -%}\n\n<div class='dw-lbl'>\n  {#- order_qr_svg comes from hooks.py; guarded so the label still prints before a restart. -#}\n  {%- if order_qr_svg is defined %}\n  <span class='qr'>{{ order_qr_svg(doc.name, \"0.62in\") }}</span>\n  {%- endif %}\n  <div class='txt'>\n    <span class='ro-id'{% if _ref | length > 6 %} style='font-size:8.5pt'{% endif %}>{{ (_ref) | e }}</span>\n    {%- if doc.reference_number %}\n    <span class='order-no'>{{ (doc.name) | e }}</span>\n    {%- endif %}\n    <span class='cust-name'>{{ (_cn | truncate(16, True, '')) | e }}</span>\n    {%- if _mb %}\n    <span class='mobile'>{{ (_digits) | e }}</span>\n    {%- endif -%}\n  </div>\n</div>\n",
