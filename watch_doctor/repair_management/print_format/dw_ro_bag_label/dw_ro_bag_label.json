 "html": "<style>\n  .print-format,\n  .print-format table,\n  .print-format tr,\n  .print-format td,\n  .print-format div,\n  .print-format p {\n    font-family: Arial, sans-serif;\n    line-height: 115%;\n    vertical-align: middle;\n    white-space: nowrap;\n    overflow: hidden;\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n  @media screen {\n    .print-format {\n      width: 1.5in;\n      padding: 0.07in 0.08in;\n      min-height: 1in;\n    }\n  }\n  @media print {\n    @page {\n      size: 1.5in 1in;\n      margin: 0;\n    }\n    .print-format {\n      width: 1.5in;\n      height: 1in;\n      padding: 0.07in 0.08in;\n      overflow: hidden;\n    }\n  }\n  .dw-lbl {\n    text-align: center;\n    width: 100%;\n  }\n  .dw-lbl .ro-id {\n    font-size: 8pt;\n    font-weight: bold;\n    display: block;\n    text-align: center;\n    letter-spacing: 0.02em;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .dw-lbl .bc-wrap {\n    text-align: center;\n    line-height: 0;\n    margin: 1px 0;\n    width: 100%;\n  }\n  .dw-lbl .bc-wrap svg {\n    max-width: 100%;\n  }\n  .dw-lbl .cust-name {\n    font-size: 7pt;\n    font-weight: bold;\n    display: block;\n    text-align: center;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .dw-lbl .mobile {\n    font-size: 7pt;\n    display: block;\n    text-align: center;\n    letter-spacing: 0.05em;\n    white-space: nowrap;\n  }\n</style>\n\n{%- set _cn = frappe.db.get_value(\"Customer\", doc.customer, \"customer_name\") or doc.customer -%}\n{%- set _mb = frappe.db.get_value(\"Customer\", doc.customer, \"mobile_no\") or \"\" -%}\n\n<div class='dw-lbl'>\n  <span class='ro-id'>{{ doc.name }}</span>\n  <div class='bc-wrap'>\n    <svg class='dw-bc'\n      jsbarcode-format='CODE128'\n      jsbarcode-margin='0'\n      jsbarcode-margintop='2'\n      jsbarcode-marginbottom='2'\n      jsbarcode-height='28'\n      jsbarcode-width='1'\n      jsbarcode-fontsize='0'\n      jsbarcode-displayvalue='false'\n      jsbarcode-value='{{ doc.name }}'></svg>\n  </div>\n  <span class='cust-name'>{{ _cn | truncate(22, True, '...') }}</span>\n  {%- if _mb %}\n  <span class='mobile'>{{ _mb }}</span>\n  {%- endif -%}\n</div>\n\n<script src='/assets/frappe/node_modules/jsbarcode/dist/JsBarcode.all.min.js'></script>\n<script>\n  if (typeof JsBarcode !== 'undefined') {\n    JsBarcode('.dw-bc').init();\n  }\n</script>",
