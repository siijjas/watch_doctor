 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    body {\r\n        font-family: 'Arial', sans-serif;\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n\r\n    .print-format {\r\n        width: 3in;\r\n        margin: 0;\r\n        padding: 0.25in;\r\n        background-color: #fff;\r\n        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\r\n    }\r\n\r\n    .header {\r\n        text-align: center;\r\n        margin-bottom: 0.5rem;\r\n    }\r\n\r\n    .header img {\r\n        max-width: 160px; /* Adjust the max-width as needed */\r\n        margin-bottom: 0.25rem;\r\n    }\r\n\r\n    .header b {\r\n        font-size: 1rem;\r\n    }\r\n\r\n    .details {\r\n        margin-bottom: 0.5rem;\r\n        font-size: 0.8rem; /* Adjust the font size as needed */\r\n    }\r\n\r\n    .details b {\r\n        display: block;\r\n        margin-bottom: 0.25rem;\r\n    }\r\n\r\n    .table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 0.5rem;\r\n    }\r\n\r\n    .table th,\r\n    .table td {\r\n        border: 1px solid #ddd;\r\n        padding: 0.15rem;\r\n        text-align: left; /* Align items to the left */\r\n    }\r\n\r\n    .table th {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n    .text-right {\r\n        text-align: right;\r\n    }\r\n\r\n    .footer {\r\n        margin-top: 0.5rem;\r\n    }\r\n\r\n    .footer p {\r\n        margin: 0;\r\n        font-size: 0.8rem; /* Adjust the font size as needed */\r\n    }\r\n</style>\r\n\r\n<div class=\"print-format\">\r\n    <div class=\"header\">\r\n        <img src=\"https://www.samaddoctorwatch.com/private/files/doctor%20logo.png\" alt=\"Company Logo\"> <br><!-- Adjust the image source path -->\r\n        <b>SAMAD DOCTOR WATCHES CO W.L.L </b><br>\r\n         <b>CR: 135058 - 2</b><br>\r\n        <b>VAT No: 220016708800002</b><br>\r\n        <b>Manama, Bahrain</b><br>\r\n        <b>MOB: 38798030</b><br>\r\n        <b>{{ (doc.select_print_heading or \"Tax Invoice\") | e }}</b>\r\n    </div>\r\n\r\n    <div class=\"details\">\r\n        <b>Invoice No:</b> {{ (doc.name) | e }}<br>\r\n        <b>Customer:</b> {{ (doc.customer_name) | e }}<br>\r\n        <b>Date:</b> {{ (doc.get_formatted(\"posting_date\")) | e }}<br>\r\n        <b>Time:</b> {{ (doc.get_formatted(\"posting_time\")) | e }}<br>\r\n    </div>\r\n\r\n    <table class=\"table\">\r\n        <thead>\r\n            <tr>\r\n                <th>Item</th>\r\n                <th>Qty</th>\r\n                <th>Amount</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {%- for item in doc.items -%}\r\n            <tr>\r\n                <td>\r\n                    {{ (item.item_code) | e }}\r\n                    {%- if item.item_name != item.item_code -%}\r\n                    <br>{{ (item.item_name) | e }}\r\n                    {%- endif -%}\r\n                    {%- if item.serial_no -%}\r\n                    <br><b>SR.No:</b><br>\r\n                    {{ (item.serial_no | replace(\"\\n\", \", \")) | e }}\r\n                    {%- endif -%}\r\n                </td>\r\n                <td>{{ (item.qty) | e }}<br>@ {{ (item.get_formatted(\"rate\")) | e }}</td>\r\n                <td>{{ (item.get_formatted(\"amount\")) | e }}</td>\r\n            </tr>\r\n            {%- endfor -%}\r\n        </tbody>\r\n    </table>\r\n\r\n    <table class=\"table\">\r\n        <tbody>\r\n            <tr>\r\n                <td style=\"width: 70%\">{{ (_(\"Total\")) | e }}</td>\r\n                <td>{{ (doc.get_formatted(\"total\", doc)) | e }}</td>\r\n            </tr>\r\n\r\n            {%- if doc.discount_amount -%}\r\n            <tr>\r\n                <td style=\"width: 75%\">{{ (_(\"Discount\")) | e }}</td>\r\n                <td>{{ (doc.get_formatted(\"discount_amount\")) | e }}</td>\r\n            </tr>\r\n            {%- endif -%}\r\n\r\n            <tr>\r\n                <td style=\"width: 75%\"><b>{{ (_(\"Sub Total\")) | e }}</b></td>\r\n                <td>{{ (doc.get_formatted(\"net_total\")) | e }}</td>\r\n            </tr>\r\n\r\n            <tr>\r\n                <td style=\"width: 75%\"><b>{{ (_(\"Vat @ 10%\")) | e }}</b></td>\r\n                <td>{{ (doc.get_formatted(\"total_taxes_and_charges\")) | e }}</td>\r\n            </tr>\r\n\r\n            <tr>\r\n                <td style=\"width: 75%\"><b>{{ (_(\"Grand Total\")) | e }}</b></td>\r\n                <td>{{ (doc.get_formatted(\"grand_total\")) | e }}</td>\r\n            </tr>\r\n\r\n            {%- if doc.rounded_total -%}\r\n            <tr>\r\n                <td style=\"width: 75%\"><b>{{ (_(\"Rounded Total\")) | e }}</b></td>\r\n                <td>{{ (doc.get_formatted(\"rounded_total\")) | e }}</td>\r\n            </tr>\r\n            {%- endif -%}\r\n        </tbody>\r\n    </table>\r\n\r\n    <div class=\"footer\">\r\n        <p>{{ doc.terms or \"\" }}</p>\r\n        <p class=\"text-center\">{{ (_(\"Thank you, please visit again.\")) | e }}</p>\r\n    </div>\r\n</div>\r\n",
